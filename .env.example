# Copy to `.env` and fill in. `.env` is gitignored — never commit secrets.
# Values here override the defaults in configs/ for environment-specific
# settings only; anything that affects results belongs in configs/, so that
# Git history records it.

# --- Experiment tracking ---------------------------------------------------
# Local file store by default; point at a tracking server when you have one.
MLFLOW_TRACKING_URI=./mlruns

# --- Data versioning -------------------------------------------------------
# Remote used by `task dvc:push` / `task dvc:pull`.
DVC_REMOTE_URL=

# --- Paths -----------------------------------------------------------------
# Override when the dataset lives outside the repository.
DATA_ROOT=./data
